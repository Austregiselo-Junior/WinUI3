<?xml version="1.0" encoding="utf-8" ?>
<Window x:ConnectionId='1'
    x:Class="WiredBrainCoffee.CustomersApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WiredBrainCoffee.CustomersApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WiredBrainCoffee.CustomersApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:ConnectionId='2' x:Name="root" Background="#222222">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!--  Auto porque queremos que o conteiner sempre contenha o que está dentro  -->
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  "Auto"Pega a altura do elemento  -->
            <RowDefinition />
            <!--  "* ou vazio" é o padrão, redimensiona porque é o tamanho que falta  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:HeaderControl Grid.ColumnSpan="3" />

        <Grid x:ConnectionId='3'
            x:Name="custmerListGris"
            Grid.Row="1"
            MaxWidth="250"
            Background="#333333">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:ConnectionId='9' Margin="10"                                        >
                    <StackPanel Orientation="Horizontal">
                        <SymbolIcon Symbol="AddFriend" />
                        <TextBlock Margin="5,0,0,0" Text="Add" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='10' Margin="0,10,10,10"                                           >
                    <StackPanel Orientation="Horizontal">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Margin="5,0,0,0" Text="Delete" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='11' Margin="0,10,10,10"                                   >
                    <SymbolIcon x:ConnectionId='12' x:Name="symbolIconMoveNavigation" Symbol="Forward" />
                </Button>
            </StackPanel>

            <ListView x:ConnectionId='8'
                x:Name="customerListView"
                Grid.Row="1"
                DisplayMemberPath="FirstName"
                                                                       
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                                                                                />
        </Grid>

        <StackPanel x:ConnectionId='4'
            Grid.Row="1"
            Grid.Column="1"
            Margin="10"
                                                                           >
            <TextBox x:ConnectionId='5' Header="Firstname"                                                                                                        />
            <TextBox x:ConnectionId='6'
                Margin="0,10,0,0"
                Header="Lastname"
                                                                                                                      />
            <CheckBox x:ConnectionId='7' Margin="0,20,0,0"                                                                                                              >
                Is developer
            </CheckBox>
        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Background="#444">
            <TextBlock
                Margin="5"
                Foreground="White"
                Text=" (c) Wired Brain Coffe" />
        </Border>
    </Grid>
</Window>

