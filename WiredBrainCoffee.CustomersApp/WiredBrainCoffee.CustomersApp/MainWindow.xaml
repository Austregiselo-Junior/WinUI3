<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WiredBrainCoffee.CustomersApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WiredBrainCoffee.CustomersApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WiredBrainCoffee.CustomersApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="using:WiredBrainCoffee.CustomersApp.ViewModel"
    mc:Ignorable="d">

    <Grid x:Name="root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.Resources>
            <DataTemplate x:Key="CustomerDataTemplate" x:DataType="viewModel:CustomerItemViewModel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Text="{x:Bind FirstName, Mode=OneWay}" />
                    <TextBlock Margin="5,0,0,0" Text="{x:Bind LastName, Mode=OneWay}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        Opacity="0.5"
                        Text="(Dev)"
                        Visibility="{x:Bind IsDeveloper, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!--  Auto porque queremos que o conteiner sempre contenha o que está dentro  -->
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  "Auto"Pega a altura do elemento  -->
            <RowDefinition />
            <!--  "* ou vazio" é o padrão, redimensiona porque é o tamanho que falta  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:HeaderControl Grid.ColumnSpan="3" />

        <Button
            Grid.Column="3"
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="ButtonToogleTheme_Click"
            Content="Yoggle theme" />

        <Grid
            x:Name="custmerListGris"
            Grid.Row="1"
            MaxWidth="250"
            Background="{ThemeResource NavigationBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="10"
                    Command="{x:Bind ViewModel.AddCommand}"
                    CommandParameter="true">
                    <StackPanel Orientation="Horizontal">
                        <SymbolIcon Symbol="AddFriend" />
                        <TextBlock Margin="5,0,0,0" Text="Add" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="0,10,10,10"
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    CommandParameter="true">
                    <StackPanel Orientation="Horizontal">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Margin="5,0,0,0" Text="Delete" />
                    </StackPanel>
                </Button>
                <Button Margin="0,10,10,10" Click="ButtonMoveNavigation_Click">
                    <SymbolIcon x:Name="symbolIconMoveNavigation" Symbol="Forward" />
                </Button>
            </StackPanel>

            <ListView
                Grid.Row="1"
                ItemTemplate="{StaticResource CustomerDataTemplate}"
                ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="10"
            Visibility="{x:Bind ViewModel.IsCustomerSelected, Mode=OneWay}">
            <TextBox Header="Firstname" Text="{x:Bind ViewModel.SelectedCustomer.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                Margin="0,10,0,0"
                Header="Lastname"
                Text="{x:Bind ViewModel.SelectedCustomer.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="0,20,0,0" IsChecked="{x:Bind ViewModel.SelectedCustomer.IsDeveloper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                Is developer
            </CheckBox>
        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Background="#444">
            <TextBlock
                Margin="5"
                Foreground="White"
                Text=" (c) Wired Brain Coffe" />
        </Border>
    </Grid>
</Window>